---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
---

<header>
	<nav>
		<h2><a href={base}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={base}>Home</HeaderLink>
			<HeaderLink href={`${base}blog/`}>Blog</HeaderLink>
			<HeaderLink href={`${base}discussion/`}>Discussion</HeaderLink>
			<HeaderLink href={`${base}about/`}>About</HeaderLink>
		</div>
		<div class="auth-link-container">
			<a href={`${base}login/`} id="nav-auth-link" class="auth-btn">Log In</a>
		</div>
	</nav>
</header>

<script>
	import { supabase } from '../utils/supabase';

	async function updateHeaderAuth() {
		const navAuthLink = document.getElementById('nav-auth-link') as HTMLAnchorElement;
		if (!navAuthLink) return;

		const { data: { session } } = await supabase.auth.getSession();
		const base = import.meta.env.BASE_URL;

		if (session) {
			navAuthLink.textContent = 'Account';
			navAuthLink.href = `${base}login/`;
			navAuthLink.style.border = '1px solid #10b981';
			navAuthLink.style.padding = '0.3em 0.8em';
			navAuthLink.style.borderRadius = '4px';
			navAuthLink.style.color = '#10b981';
		} else {
			navAuthLink.textContent = 'Log In';
			navAuthLink.href = `${base}login/`;
			navAuthLink.style.border = 'none';
			navAuthLink.style.padding = '1em 0.5em';
			navAuthLink.style.color = '#e4e4e7';
		}
	}

	updateHeaderAuth();
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #111111;
		border-bottom: 1px solid #222222;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: white;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: #e4e4e7;
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}
	nav a:hover,
	nav a.active {
		color: white;
		border-bottom-color: #ffffff;
	}
	.internal-links {
		display: flex;
		gap: 0.5em;
	}
	.auth-link-container {
		display: flex;
		align-items: center;
	}
</style>