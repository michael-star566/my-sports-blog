---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const currentPath = Astro.url.pathname;
const targetHref = typeof href === 'string' ? href : '';

// Determine active state by checking if current path matches or starts with the target href
const isActive = currentPath === targetHref || (targetHref !== '/my-sports-blog/' && currentPath.startsWith(targetHref));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>