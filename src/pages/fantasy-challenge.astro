---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RosterBoard from '../components/RosterBoard.astro';
import SpinWheel from '../components/SpinWheel.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Import our flawlessly formatted JSON dataset directly!
import stats from '../data/fantasy-stats.json';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Fantasy Challenge - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      main {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 2em 1em;
        color: white;
      }
      h1 {
        text-align: center;
        margin-bottom: 0.5rem;
        font-size: 2.2rem;
      }
      .subtitle {
        text-align: center;
        color: #a1a1aa;
        margin-bottom: 2.5rem;
        font-size: 1rem;
      }
      
      .game-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: center;
      }
      
      @media (min-width: 900px) {
        .game-container {
          flex-direction: row;
          align-items: flex-start;
          justify-content: center;
          gap: 4rem;
        }
      }

      .interactive-section, .roster-section {
        width: 100%;
        display: flex;
        justify-content: center;
      }

      .interactive-section {
        min-height: 480px; /* Keeps the page from jumping up and down when swapping views */
      }

      #wheel-container {
        width: 100%;
        display: block; /* Visible by default */
      }

      /* Inline Draft UI */
      #draft-container {
        display: none; /* Hidden by default */
        flex-direction: column;
        background: #111111;
        border: 2px solid #38bdf8;
        border-radius: 8px;
        padding: 1.5rem;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.6);
      }
      #draft-container h3 {
        margin: 0 0 0.5rem 0;
        color: #f4f4f5;
        font-size: 1.5rem;
        text-align: center;
      }
      .highlight-text {
        color: #38bdf8;
      }
      .draft-sub {
        color: #a1a1aa;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        text-align: center;
      }
      
      /* Styling the select as an open list box */
      select {
        width: 100%;
        background: #18181b;
        color: white;
        border: 1px solid #27272a;
        border-radius: 6px;
        font-size: 1rem;
        outline: none;
        margin-bottom: 1.5rem;
        padding: 0.5rem;
      }
      select:focus {
        border-color: #38bdf8;
      }
      select option {
        padding: 0.5rem;
        border-bottom: 1px solid #27272a;
      }
      select option:checked {
        background-color: #38bdf8;
        color: #111111;
      }

      .draft-actions {
        display: flex;
        gap: 1rem;
      }
      .btn-draft {
        flex: 1;
        background: #38bdf8;
        color: #111111;
        border: none;
        padding: 0.75rem;
        font-weight: 800;
        font-size: 0.95rem;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.2s ease;
      }
      .btn-draft:hover:not(:disabled) {
        background: #0ea5e9;
      }
      .btn-draft:disabled {
        background: #52525b;
        color: #a1a1aa;
        cursor: not-allowed;
      }
      .btn-skip {
        flex: 1;
        background: transparent;
        color: #a1a1aa;
        border: 1px solid #52525b;
        padding: 0.75rem;
        font-weight: bold;
        font-size: 0.95rem;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .btn-skip:hover {
        background: #27272a;
        color: white;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Fantasy Challenge</h1>
      <p class="subtitle">Spin the wheel. Draft your player. Build the ultimate roster.</p>
      
      <div class="game-container">
        <!-- Left Side: Wheel OR Draft UI -->
        <div class="interactive-section">
          
          <div id="wheel-container">
            <SpinWheel />
          </div>

          <div id="draft-container">
            <h3>Drafting from <span id="draft-team-name" class="highlight-text"></span></h3>
            <p class="draft-sub">Select a player to fill an open roster spot.</p>

            <!-- size="8" turns this into an open scrolling list box -->
            <select id="player-select" size="8">
              <!-- Populated dynamically by JavaScript -->
            </select>

            <div class="draft-actions">
              <button id="btn-skip" class="btn-skip">Skip Team</button>
              <button id="btn-draft" class="btn-draft">Draft Player</button>
            </div>
          </div>

        </div>

        <!-- Right Side: The Roster Board -->
        <div class="roster-section">
          <RosterBoard />
        </div>
      </div>
    </main>

    <Footer />

    <!-- The Game Engine -->
    <script define:vars={{ stats }}>
      // 1. Set up our empty state
      const roster = {
        QB: null,
        RB1: null,
        RB2: null,
        WR1: null,
        WR2: null,
        TE: null,
        FLEX: null
      };

      let currentDraftPool = [];

      const wheelContainer = document.getElementById('wheel-container');
      const draftContainer = document.getElementById('draft-container');

      // 2. Listen for the wheel to stop spinning
      document.addEventListener('teamDrafted', (e) => {
        const team = e.detail;
        const teamName = document.getElementById('draft-team-name');
        const select = document.getElementById('player-select');
        const btnDraft = document.getElementById('btn-draft');

        // Filter players based on team, duplicates, and available slots
        currentDraftPool = stats.filter(p => {
          if (p.Team !== team) return false;
          
          const isDrafted = Object.values(roster).some(r => r && r.Player === p.Player);
          if (isDrafted) return false;

          if (p.Position === 'QB') return !roster.QB;
          if (p.Position === 'RB') return !roster.RB1 || !roster.RB2 || !roster.FLEX;
          if (p.Position === 'WR') return !roster.WR1 || !roster.WR2 || !roster.FLEX;
          if (p.Position === 'TE') return !roster.TE || !roster.FLEX;
          
          return false;
        });

        // Sort highest scorers to the top of the dropdown
        currentDraftPool.sort((a, b) => b.Points - a.Points);

        teamName.textContent = team;
        select.innerHTML = '';

        // Handle empty pool scenarios
        if (currentDraftPool.length === 0) {
          const opt = document.createElement('option');
          opt.text = 'No available players for open slots';
          opt.value = '';
          opt.disabled = true;
          select.appendChild(opt);
          btnDraft.disabled = true;
        } else {
          currentDraftPool.forEach((p, idx) => {
            const opt = document.createElement('option');
            opt.value = idx;
            opt.text = `${p.Player} (${p.Position}) - ${p.Points} PPG`;
            select.appendChild(opt);
          });
          btnDraft.disabled = false;
        }

        // Swap Views
        wheelContainer.style.display = 'none';
        draftContainer.style.display = 'flex';
      });

      // 3. Skip Button Logic
      document.getElementById('btn-skip').addEventListener('click', () => {
        draftContainer.style.display = 'none';
        wheelContainer.style.display = 'block';
      });

      // 4. Draft Button Logic
      document.getElementById('btn-draft').addEventListener('click', () => {
        const select = document.getElementById('player-select');
        if (select.disabled || !select.value) return;

        const player = currentDraftPool[select.value];
        let assignedSlot = null;

        // Slot prioritization logic (Main position first, then FLEX)
        if (player.Position === 'QB') assignedSlot = 'QB';
        else if (player.Position === 'RB') {
          if (!roster.RB1) assignedSlot = 'RB1';
          else if (!roster.RB2) assignedSlot = 'RB2';
          else assignedSlot = 'FLEX';
        }
        else if (player.Position === 'WR') {
          if (!roster.WR1) assignedSlot = 'WR1';
          else if (!roster.WR2) assignedSlot = 'WR2';
          else assignedSlot = 'FLEX';
        }
        else if (player.Position === 'TE') {
          if (!roster.TE) assignedSlot = 'TE';
          else assignedSlot = 'FLEX';
        }

        if (assignedSlot) {
          roster[assignedSlot] = player;
          
          // Inject player data directly into the RosterBoard HTML
          const slotEl = document.getElementById(`slot-${assignedSlot.toLowerCase()}`);
          if (slotEl) {
            slotEl.classList.remove('empty');
            slotEl.querySelector('.player-name').textContent = player.Player;
            slotEl.querySelector('.player-team').textContent = player.Team;
            slotEl.querySelector('.slot-points').textContent = player.Points.toFixed(1);
          }

          // Calculate running total
          let total = 0;
          Object.values(roster).forEach(p => {
            if (p) total += p.Points;
          });
          document.getElementById('roster-total').textContent = total.toFixed(1);
        }

        // Swap back to Wheel View
        draftContainer.style.display = 'none';
        wheelContainer.style.display = 'block';

        // Check Win Condition
        const isFull = Object.values(roster).every(p => p !== null);
        if (isFull) {
          setTimeout(() => {
            alert('Draft Complete! Your final roster averages ' + document.getElementById('roster-total').textContent + ' PPG.');
            const spinBtn = document.getElementById('spin-btn');
            if(spinBtn) {
              spinBtn.disabled = true;
              spinBtn.style.opacity = '0.5';
              spinBtn.textContent = 'DONE';
            }
          }, 300);
        }
      });
    </script>
  </body>
</html>