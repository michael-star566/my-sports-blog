---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title="Blog & Analysis | Sports Analytics Blog" description="Data-backed insights, model previews, and statistical breakdowns." />
  </head>
  <body class="bg-gray-950 text-white min-h-screen flex flex-col">
    <Header />
    
    <main class="max-w-6xl mx-auto px-4 py-8 flex-grow w-full">
      
      <!-- Header Section with Blog Category Dropdown Toggle -->
      <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4 border-b border-gray-800 pb-6">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Sports Blog & Analysis</h1>
          <p class="text-gray-400 mt-1">Data-backed insights, model previews, and statistical breakdowns.</p>
        </div>

        <!-- Blog Category Dropdown -->
        <div class="flex items-center gap-3">
          <label for="blogCategorySelect" class="text-sm font-medium text-gray-300">Category:</label>
          <select 
            id="blogCategorySelect" 
            class="bg-gray-900 border border-gray-700 text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none cursor-pointer"
          >
            <option value="nfl">NFL Blog Articles</option>
            <option value="nba" selected>NBA Blog Articles</option>
          </select>
        </div>
      </div>

      <!-- NFL Blog Section Feed -->
      <div id="nfl-blog-feed" class="blog-feed hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <article class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-md hover:border-gray-700 transition-colors">
            <span class="text-xs text-blue-400 uppercase tracking-wider font-semibold">NFL Analysis</span>
            <h2 class="text-xl font-bold mt-2 mb-2">Early Season AFC Contender Breakdown</h2>
            <p class="text-gray-400 text-sm mb-4">Examining underlying metrics and advanced passing numbers heading into Week 1.</p>
            <a href="#" class="text-blue-400 hover:underline text-sm font-medium">Read Article &rarr;</a>
          </article>
        </div>
      </div>

      <!-- NBA Blog Section Feed (Default) -->
      <div id="nba-blog-feed" class="blog-feed">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <article class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-md hover:border-gray-700 transition-colors">
            <span class="text-xs text-yellow-400 uppercase tracking-wider font-semibold">NBA Model Preview</span>
            <h2 class="text-xl font-bold mt-2 mb-2">2026-27 NBA Model: OKC & San Antonio Lead the Way</h2>
            <p class="text-gray-400 text-sm mb-4">Deep dive into our 10,000-run Monte Carlo simulation results, win-total ceilings, and conference parity.</p>
            <a href="#" class="text-blue-400 hover:underline text-sm font-medium">Read Article &rarr;</a>
          </article>
        </div>
      </div>

    </main>

    <Footer />

    <script>
      const blogSelect = document.getElementById('blogCategorySelect') as HTMLSelectElement | null;
      const nflBlogFeed = document.getElementById('nfl-blog-feed') as HTMLElement | null;
      const nbaBlogFeed = document.getElementById('nba-blog-feed') as HTMLElement | null;

      if (blogSelect && nflBlogFeed && nbaBlogFeed) {
        blogSelect.addEventListener('change', (e) => {
          const target = e.target as HTMLSelectElement;
          if (target.value === 'nfl') {
            nflBlogFeed.classList.remove('hidden');
            nbaBlogFeed.classList.add('hidden');
          } else {
            nflBlogFeed.classList.add('hidden');
            nbaBlogFeed.classList.remove('hidden');
          }
        });
      }
    </script>
  </body>
</html>