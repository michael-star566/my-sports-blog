---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title="Power Rankings | Sports Analytics Blog" description="Advanced model projections and standings." />
  </head>
  <body class="bg-gray-950 text-white min-h-screen flex flex-col">
    <Header />
    
    <main class="max-w-6xl mx-auto px-4 py-8 flex-grow w-full">
      
      <!-- Header Section with League Dropdown Toggle -->
      <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4 border-b border-gray-800 pb-6">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">League Power Rankings</h1>
          <p class="text-gray-400 mt-1">Select a league to view advanced model projections and standings.</p>
        </div>

        <!-- Dropdown Toggle -->
        <div class="flex items-center gap-3">
          <label for="powerRankingSelect" class="text-sm font-medium text-gray-300">View League:</label>
          <select 
            id="powerRankingSelect" 
            class="bg-gray-900 border border-gray-700 text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none cursor-pointer"
          >
            <option value="nfl">NFL Power Rankings</option>
            <option value="nba" selected>NBA Power Rankings (2026-27 Model)</option>
          </select>
        </div>
      </div>

      <!-- NFL Power Rankings Container -->
      <div id="nfl-power-section" class="power-section hidden">
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-lg">
          <h2 class="text-xl font-semibold mb-4 text-blue-400">NFL Power Rankings</h2>
          <p class="text-gray-400 mb-6">Current NFL analytical data feed and power ratings.</p>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="border-b border-gray-800 text-gray-400">
                  <th class="py-3 px-4">Team</th>
                  <th class="py-3 px-4">Record / Tier</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-800/60">
                <tr>
                  <td class="py-3 px-4 font-medium">Kansas City Chiefs</td>
                  <td class="py-3 px-4 text-blue-400">Tier 1 Contender</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- NBA Power Rankings Container (Default) -->
      <div id="nba-power-section" class="power-section">
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-lg">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-semibold text-blue-400">2026-27 NBA Monte Carlo Projections (10,000 Runs)</h2>
            <span class="text-xs text-gray-400 bg-gray-800 px-3 py-1 rounded-full">Injury-Adjusted Model</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="border-b border-gray-800 text-gray-400 uppercase text-xs tracking-wider">
                  <th class="py-3 px-4">Team</th>
                  <th class="py-3 px-4 text-center">Avg Wins</th>
                  <th class="py-3 px-4 text-center">High</th>
                  <th class="py-3 px-4 text-center">Low</th>
                  <th class="py-3 px-4 text-center">Playoff %</th>
                  <th class="py-3 px-4 text-center">Title %</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-800/60">
                <tr class="hover:bg-gray-800/40 transition-colors">
                  <td class="py-3 px-4 font-medium">San Antonio Spurs</td>
                  <td class="py-3 px-4 text-center">60.7</td>
                  <td class="py-3 px-4 text-center text-green-400">68</td>
                  <td class="py-3 px-4 text-center text-red-400">52</td>
                  <td class="py-3 px-4 text-center">100.0%</td>
                  <td class="py-3 px-4 text-center font-bold text-yellow-400">35.2%</td>
                </tr>
                <tr class="hover:bg-gray-800/40 transition-colors">
                  <td class="py-3 px-4 font-medium">Oklahoma City Thunder</td>
                  <td class="py-3 px-4 text-center">60.7</td>
                  <td class="py-3 px-4 text-center text-green-400">68</td>
                  <td class="py-3 px-4 text-center text-red-400">51</td>
                  <td class="py-3 px-4 text-center">100.0%</td>
                  <td class="py-3 px-4 text-center font-bold text-yellow-400">35.3%</td>
                </tr>
                <tr class="hover:bg-gray-800/40 transition-colors">
                  <td class="py-3 px-4 font-medium">Detroit Pistons</td>
                  <td class="py-3 px-4 text-center">50.4</td>
                  <td class="py-3 px-4 text-center text-green-400">59</td>
                  <td class="py-3 px-4 text-center text-red-400">41</td>
                  <td class="py-3 px-4 text-center">100.0%</td>
                  <td class="py-3 px-4 text-center font-bold text-yellow-400">7.0%</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>
    
    <Footer />

    <script>
      const powerSelect = document.getElementById('powerRankingSelect') as HTMLSelectElement | null;
      const nflPowerSection = document.getElementById('nfl-power-section') as HTMLElement | null;
      const nbaPowerSection = document.getElementById('nba-power-section') as HTMLElement | null;

      if (powerSelect && nflPowerSection && nbaPowerSection) {
        powerSelect.addEventListener('change', (e) => {
          const target = e.target as HTMLSelectElement;
          if (target.value === 'nfl') {
            nflPowerSection.classList.remove('hidden');
            nbaPowerSection.classList.add('hidden');
          } else {
            nflPowerSection.classList.add('hidden');
            nbaPowerSection.classList.remove('hidden');
          }
        });
      }
    </script>
  </body>
</html>